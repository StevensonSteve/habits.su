{% extends 'base.html.twig' %}

{% block title %}ExpenseCategory index{% endblock %}

{% block body %}
    <h1>ExpenseCategory index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>CreatedAt</th>
                <th>UpdatedAt</th>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for expense_category in expense_categories %}
            <tr>
                <td>{{ expense_category.createdAt ? expense_category.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ expense_category.updatedAt ? expense_category.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ expense_category.id }}</td>
                <td>{{ expense_category.name }}</td>
                <td>{{ expense_category.description }}</td>
                <td>
                    <a href="{{ path('app_expense_category_show', {'id': expense_category.id}) }}">show</a>
                    <a href="{{ path('app_expense_category_edit', {'id': expense_category.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_expense_category_new') }}">Create new</a>
{% endblock %}
