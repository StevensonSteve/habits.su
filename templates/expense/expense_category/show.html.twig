{% extends 'base.html.twig' %}

{% block title %}ExpenseCategory{% endblock %}

{% block body %}
    <h1>ExpenseCategory</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ expense_category.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ expense_category.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ expense_category.description }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ expense_category.createdAt ? expense_category.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ expense_category.updatedAt ? expense_category.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_expense_category_index') }}">back to list</a>

    <a href="{{ path('app_expense_category_edit', {'id': expense_category.id}) }}">edit</a>

    {{ include('expense/expense_category/_delete_form.html.twig') }}
{% endblock %}
