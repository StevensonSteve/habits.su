{% extends 'base.html.twig' %}

{% block title %}Журнал{% endblock %}

{% block body %}
<section class="w-full max-w-md md:max-w-4xl mx-auto mt-0 md:mt-6 h-screen md:h-[90vh] flex flex-col overflow-hidden rounded-b-2xl md:rounded-2xl border-x border-b md:border border-line bg-card shadow-lg shadow-blue-100/80" id="screen-home">
    
<div class="flex-shrink-0 bg-gradient-to-r from-blue-600 to-sky-500 px-4 py-3 text-white">
    <a class="text-xs text-white/80 hover:text-white transition-colors" href="{{ path('dashboard_index') }}" onclick="show('home');return false;">← главная</a>
    <div class="text-lg font-semibold">Журнал</div>
</div>

<div class="flex mb-2 mt-4 flex-wrap gap-1.5">
    <form action="{{ path('activity_log_index') }}" method="POST" class="flex-1">
        <input type="hidden" name="filter" value="today">
    
        <button type="submit" 
                class="w-full rounded-full px-3 py-1.5 text-xs  
                    {{filter == 'today' 
                        ? 'font-medium bg-brand text-white' 
                        : 'text-muted hover:bg-brand-soft' }}">
            сегодня
        </button>
    </form>
    <form action="{{ path('activity_log_index') }}" method="POST" class="flex-1">
        <input type="hidden" name="filter" value="yesterday">
    
        <button type="submit" 
                class="w-full rounded-full px-3 py-1.5 text-xs  
                    {{filter == 'yesterday' 
                        ? 'font-medium bg-brand text-white' 
                        : 'text-muted hover:bg-brand-soft' }}">
            вчера
        </button>
    </form>
    <form action="{{ path('activity_log_index') }}" method="POST" class="flex-1">
        <input type="hidden" name="filter" value="week">
    
        <button type="submit" 
                class="w-full rounded-full px-3 py-1.5 text-xs  
                    {{filter == 'week' 
                        ? 'font-medium bg-brand text-white' 
                        : 'text-muted hover:bg-brand-soft' }}">
            неделя
        </button>
    </form>
    <form action="{{ path('activity_log_index') }}" method="POST" class="flex-1">
        <input type="hidden" name="filter" value="month">
    
        <button type="submit" 
                class="w-full rounded-full px-3 py-1.5 text-xs  
                    {{filter == 'month' 
                        ? 'font-medium bg-brand text-white' 
                        : 'text-muted hover:bg-brand-soft' }}">
            месяц
        </button>
    </form>
    <a class="rounded-full px-3 py-1.5 text-xs text-muted hover:bg-brand-soft text-center flex-1" href="#" onclick="show('custom-filter');return false;">свой</a>
</div>
    
    {# <label class="mb-1 mt-3 block text-xs text-muted">категория</label>
    <select multiple class="w-full rounded-xl border border-line bg-page px-3 py-2 text-sm text-slate-700 outline-none">
        <option value="all">все</option>
        {% if activity is not empty %}
            {% for act in activity %}
                <option value="{{ act.id }}">{{ act.name }}</option>
            {% endfor %}
        {% endif %}
    </select> #}

{# <div class="mt-3 rounded-xl bg-brand-soft px-3 py-2 text-sm text-brand font-medium">
    месяц · 62 записи
</div> #}

<div class="flex-1 overflow-y-auto p-4 pt-3">
    {% if records is not empty %} 
        <ul class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-white">
        {% for record in records %}  
            <li class="flex justify-between px-3 py-2.5 text-sm md:text-base text-slate-700 hover:bg-slate-50 transition-colors">
                <span>
                    <b>{{ record.date_group|date('d M')|trans }} · </b>
                    <b>{{ record.sum }} {{ record.unit == 1 ? 'раз' : (record.unit == 2 ? 'км' : (record.unit == 3 ? 'мин' : 'стр')) }}</b> · 
                    <b>{{ record.name }}</b>
                </span>
                <span class="text-xs md:text-sm flex items-center">
                    {# <a class="text-bad hover:underline" href="{{ path('record_delete', {'id': record.id}) }}" onclick="return confirm('Удалить запись?');">уд.</a> #}
                </span>
            </li>
        {% endfor %}
        </ul>
    {% else %}
    <div class="rounded-xl border border-dashed border-line p-8 text-center text-xs md:text-sm text-muted">
        История записей пуста
    </div>
    {% endif %}
</div>


</section>
{% endblock %}
