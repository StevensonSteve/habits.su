{% extends 'base.html.twig' %}

{% block title %}Трекер активностей{% endblock %}

{% block body %}
<section class="w-[360px] mx-auto mt-8 overflow-hidden rounded-2xl border border-line bg-card shadow-lg shadow-blue-100/80" id="screen-home">
      {# Шапка трекера #}
      <div class="flex items-center justify-between bg-gradient-to-r from-blue-600 to-sky-500 px-4 py-3 text-white">
        <div>
          <div class="text-xs text-white/80">главная</div>
          <div class="text-lg font-semibold">Трекер</div>
        </div>
        <div class="text-sm text-white/90">{{ "now"|date('d ') }}{{ "now"|date('M')|trans }}</div>      
      </div>
      
      <div class="p-4">

        <div class="mt-3 space-y-2">
          <form action="{{ path('category_update', {'id': category.id}) }}" method="POST">
            <label for="username">Название категории:</label>
            <input type="text" id="category_name" name="name" value="{{ category.name|default('') }}" required>           
            <button type="submit">Изменить</button>
          </form>
        </div>

        {# Нижняя навигация #}
        <nav class="mt-4 flex flex-wrap gap-x-4 gap-y-2 border-t border-line pt-3 text-sm">
          <a class="font-semibold text-brand" href="#" onclick="show('home');return false;">главная</a>
          <a class="text-muted hover:text-brand" href="#" onclick="show('journal');return false;">журнал</a>
          <a class="text-muted hover:text-brand" href="#">+ категория</a>
          <a class="text-muted hover:text-brand" href="#" onclick="show('admin');return false;">админка</a>
          <a class="text-muted hover:text-brand" href="#" onclick="show('login');return false;">выйти</a>
        </nav>
      </div>
</section>
{% endblock %}
