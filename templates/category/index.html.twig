{% extends 'base.html.twig' %}

{% block title %}Трекер активностей{% endblock %}

{% block body %}
<section class="w-[360px] mx-auto mt-8 overflow-hidden rounded-2xl border border-line bg-card shadow-lg shadow-blue-100/80" id="screen-home">
  <div class="flex items-center justify-between bg-gradient-to-r from-blue-600 to-sky-500 px-4 py-3 text-white">
    <div>
      <div class="text-xs text-white/80">главная</div>
      <div class="text-lg font-semibold">Трекер</div>
    </div>
    <div class="text-sm text-white/90">{{ "now"|date('d ') }}{{ "now"|date('M')|trans }}</div>      
  </div>

  <div class="p-5">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-semibold text-slate-800">Категории</h2>
      <a class="text-xs font-medium text-brand hover:underline" href="{{ path('category_new') }}" onclick="show('category-form');return false;">+ категория</a>
    </div>

    <div class="mt-4 space-y-2">
      {% if categories is not empty %}
          {% for category in categories %}                 
            <div class="flex items-center justify-between rounded-xl border border-line bg-page px-4 py-3">
              <span class="font-medium text-slate-700">
                <a class="hover:text-brand transition-colors" href="{{ path('category_view', {'id': category.id}) }}">
                  {{ category.name }}
                </a>
              </span>
              <div class="flex items-center gap-3 text-xs">
                <a class="text-muted hover:text-brand transition-colors" href="{{ path('category_update', {'id': category.id}) }}">изм.</a>
                <span class="text-line">|</span>
                <a class="text-muted hover:text-danger transition-colors" href="{{ path('category_delete', {'id': category.id}) }}" onclick="return confirm('Удалить категорию?');">удл.</a>
              </div>
            </div>
          {% endfor %}
      {% else %}
          <div class="rounded-xl border border-dashed border-line p-5 text-center text-xs text-muted">
              Категории на сегодня не созданы.
          </div>
      {% endif %}
    </div>

    <nav class="mt-5 flex flex-wrap gap-x-4 gap-y-2 border-t border-line pt-4 text-xs font-medium uppercase tracking-wider">
      <a class="text-brand" href="#" onclick="show('home');return false;">главная</a>
      <a class="text-muted hover:text-brand transition-colors" href="#" onclick="show('journal');return false;">журнал</a>
      <a class="text-muted hover:text-brand transition-colors" href="#" onclick="show('admin');return false;">админка</a>
      <a class="text-muted hover:text-brand transition-colors" href="#" onclick="show('login');return false;">выйти</a>
    </nav>
  </div>
</section>
{% endblock %}
