{% extends 'base.html.twig' %}

{% block title %}Трекер активностей{% endblock %}

{% block body %}
<section class="w-full max-w-md md:max-w-4xl mx-auto mt-0 md:mt-6 h-screen md:h-[90vh] flex flex-col overflow-hidden rounded-b-2xl md:rounded-2xl border-x border-b md:border border-line bg-card shadow-lg shadow-blue-100/80" id="screen-home">
  
  <div class="flex-shrink-0 border-b border-line bg-brand-soft px-4 py-3 text-xs font-medium text-brand">
    <div class="flex justify-between items-center">
      <a class="text-brand transition-colors hover:text-brand-dark" href="{{ path('dashboard_index') }}" onclick="show('home');return false;">← главная</a>
      <a class="text-brand transition-colors hover:text-brand-dark" href="{{ path('activity_new', {'id': category.id}) }}" onclick="show('activity-form');return false;">+ занятие</a>
    </div>
  </div>

  {{ include('_partials/_flash_messages.html.twig') }}

  <div class="flex-shrink-0 p-5 pb-2 md:p-6 md:pb-2">
    <h2 class="text-xl font-semibold text-slate-800">{{ category.name }}</h2>
  </div>
    
  <div class="flex-1 overflow-y-auto px-5 md:px-6 pb-4">
    <div class="space-y-3">
      {% if activities is not empty %}
          {% for activity in activities %}    
            <article class="rounded-2xl border border-line bg-page p-4">
              <div class="flex items-start justify-between gap-2">
                <div>
                  <a class="font-semibold text-slate-700 hover:text-brand transition-colors" href="{{ path('activity_view', {'id': activity.id}) }}" onclick="show('activity');return false;">{{ activity.name }}</a>
                  <p class="mt-0.5 text-xs text-muted">сегодня: {{activity.count + 0}} {{ activity.unit == 1 ? 'раз' : (activity.unit == 2 ? 'км' : (activity.unit == 3 ? 'мин' : 'стр')) }}</p>
                </div>
                <div class="flex items-center gap-3 text-xs">
                  <a class="text-muted hover:text-brand transition-colors" href="{{ path('activity_update', {'id': activity.id}) }}">изм.</a>
                  <span class="text-line">|</span>
                  <a class="text-muted hover:text-danger transition-colors" href="{{ path('activity_delete', {'id': activity.id}) }}" onclick="return confirm('Удалить активность?');">удл.</a>
                </div>
                {% if activity.goal > 0 %}
                  <span class="{{activity.goal <= activity.count ? 'bg-green-200' : ''}} rounded-full bg-brand-soft px-2.5 py-1 text-xs font-medium text-brand">{{activity.count + 0}}/{{activity.goal}}</span>
                {% endif %}
              </div>
              
              <div class="mt-4 flex flex-wrap gap-2">
                <form action="{{ path('record_new', {'id': activity.id}) }}" method="POST" class="flex-1">
                  <input type="hidden" name="amount" value={{ activity.unit == 1 ? "1" : (activity.unit == 2 ? "0.1" : (activity.unit == 3 ? "5" : "1")) }}>
                
                  <button type="submit" 
                          onclick="toast('+{{ activity.unit == 1 ? "1" : (activity.unit == 2 ? "0.1" : (activity.unit == 3 ? "5" : "1")) }}')" 
                          class="w-full min-h-11 rounded-xl bg-brand font-medium text-white shadow-md shadow-brand/10 transition-colors hover:bg-brand-dark">
                      +{{ activity.unit == 1 ? "1" : (activity.unit == 2 ? "0.1" : (activity.unit == 3 ? "5" : "1")) }}
                  </button>
                </form>
                <form action="{{ path('record_new', {'id': activity.id}) }}" method="POST" class="flex-1">
                  <input type="hidden" name="amount" value={{ activity.unit == 5 ? "1" : (activity.unit == 2 ? "0.5" : (activity.unit == 3 ? "15" : "5")) }}>
                  
                  <button type="submit" 
                          onclick="toast('+{{ activity.unit == 1 ? "5" : (activity.unit == 2 ? "0.5" : (activity.unit == 3 ? "15" : "5")) }}')" 
                          class="w-full min-h-11 rounded-xl bg-brand font-medium text-white shadow-md shadow-brand/10 transition-colors hover:bg-brand-dark">
                      +{{ activity.unit == 5 ? "1" : (activity.unit == 2 ? "0.5" : (activity.unit == 3 ? "15" : "5")) }}
                  </button>
                </form>
                <form action="{{ path('record_new', {'id': activity.id}) }}" method="POST" class="flex-1">
                  <input type="hidden" name="amount" value={{ activity.unit == 1 ? "15" : (activity.unit == 2 ? "1" : (activity.unit == 3 ? "30" : "15")) }}>
                  
                  <button type="submit" 
                          onclick="toast('+{{ activity.unit == 1 ? "15" : (activity.unit == 2 ? "1" : (activity.unit == 3 ? "30" : "15")) }}')" 
                          class="w-full min-h-11 rounded-xl bg-brand font-medium text-white shadow-md shadow-brand/10 transition-colors hover:bg-brand-dark">
                      +{{ activity.unit == 1 ? "15" : (activity.unit == 2 ? "1" : (activity.unit == 3 ? "30" : "15")) }}
                  </button>
                </form>
                <form action="{{ path('record_new', {'id': activity.id}) }}" method="POST" class="w-full mt-2 flex gap-2">
                  <div class="relative flex-1">
                    {% include '_partials/_amount_input.html.twig' with {
                        'placeholder': 'свой вариант',
                        'input_class': 'w-full min-h-11 px-4 rounded-xl border border-line bg-transparent text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition-all'
                    } %}
                  </div>
                
                  <button type="submit" 
                        class="px-5 min-h-11 rounded-xl bg-brand font-medium text-white shadow-md shadow-brand/10 transition-colors hover:bg-brand-dark">
                  ОК
                  </button>
                </form>
              </div>
            </article>
          {% endfor %}
      {% else %}
          <div class="rounded-xl border border-dashed border-line p-5 text-center text-xs text-muted">
              Активности в этой категории не созданы.
          </div>
      {% endif %}
    </div>
  </div>  

  <nav class="flex-shrink-0 bg-card border-t border-line p-4 shadow-[0_-4px_12px_rgba(0,0,0,0.05)] z-50 flex flex-wrap gap-x-4 gap-y-2 text-xs font-medium uppercase tracking-wider">
    <a class="text-muted hover:text-brand transition-colors" href="{{ path('dashboard_index') }}" onclick="show('home');return false;">главная</a>
    <a class="text-muted hover:text-brand transition-colors" href="{{ path('activity_log_index') }}" onclick="show('journal');return false;">журнал</a>
    <a class="text-muted hover:text-brand transition-colors" href="#" onclick="show('category-history');return false;">история</a>
  </nav>

</section>
{% endblock %}

