{% extends 'base.html.twig' %}

{% block title %}Трекер активностей{% endblock %}

{% block body %}
<section class="w-[360px] mx-auto mt-8 overflow-hidden rounded-2xl border border-line bg-card shadow-lg shadow-blue-100/80" id="screen-category">
  {# Шапка экрана #}
  <div class="border-b border-line bg-brand-soft px-4 py-3 text-xs font-medium text-brand">
    <div class="flex justify-between items-center">
      <a class="text-brand transition-colors hover:text-brand-dark" href="{{ path('category_index') }}" onclick="show('home');return false;">← главная</a>
      <a class="text-brand transition-colors hover:text-brand-dark" href="{{ path('activity_new', {'id': category.id}) }}" onclick="show('activity-form');return false;">+ занятие</a>
    </div>
  </div>

  <div class="p-5">
    <h2 class="text-xl font-semibold text-slate-800">{{ category.name }}</h2>
    
    {# Список активностей #}
    <div class="mt-4 space-y-3">
      {% if activities is not empty %}
          {% for activity in activities %}    
            <article class="rounded-2xl border border-line bg-page p-4">
              <div class="flex items-start justify-between gap-2">
                <div>
                  <a class="font-semibold text-slate-700 hover:text-brand transition-colors" href="#" onclick="show('activity');return false;">{{ activity.name }}</a>
                  <p class="mt-0.5 text-xs text-muted">сегодня: 12 {{ activity.unit == 1 ? 'раз' : (activity.unit == 2 ? 'км' : 'мин') }}</p>
                </div>
                <span class="rounded-full bg-brand-soft px-2.5 py-1 text-xs font-medium text-brand">12/20</span>
              </div>
              
              {# Быстрые кнопки управления #}
              <div class="mt-4 flex flex-wrap gap-2">
                <button class="min-h-11 flex-1 rounded-xl bg-brand font-medium text-white shadow-md shadow-brand/10 transition-colors hover:bg-brand-dark" onclick="toast('+1')">+1</button>
                <button class="min-h-11 flex-1 rounded-xl bg-brand font-medium text-white shadow-md shadow-brand/10 transition-colors hover:bg-brand-dark" onclick="toast('+5')">+5</button>
                <button class="min-h-11 flex-1 rounded-xl bg-brand font-medium text-white shadow-md shadow-brand/10 transition-colors hover:bg-brand-dark" onclick="toast('+10')">+10</button>
                <button class="min-h-11 flex-[1.5] rounded-xl border border-line bg-card font-medium text-muted transition-colors hover:bg-page" onclick="show('activity')">своя</button>
              </div>
            </article>
          {% endfor %}
      {% else %}
          <div class="rounded-xl border border-dashed border-line p-5 text-center text-xs text-muted">
              Активности в этой категории не созданы.
          </div>
      {% endif %}
    </div>

    {# Нижняя навигация #}
    <nav class="mt-5 flex flex-wrap gap-x-4 gap-y-2 border-t border-line pt-4 text-xs font-medium uppercase tracking-wider">
      <a class="text-muted hover:text-brand transition-colors" href="{{ path('category_index') }}" onclick="show('home');return false;">главная</a>
      <a class="text-muted hover:text-brand transition-colors" href="#" onclick="show('journal');return false;">журнал</a>
      <a class="text-muted hover:text-brand transition-colors" href="#" onclick="show('category-history');return false;">история</a>
    </nav>
  </div>
</section>
{% endblock %}
