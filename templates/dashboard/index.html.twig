{% extends 'base.html.twig' %}

{% block title %}Трекер привычек{% endblock %}

{% block body %}
  <section class="w-full max-w-md md:max-w-4xl mx-auto mt-0 md:mt-6 h-screen md:h-[90vh] flex flex-col overflow-hidden rounded-b-2xl md:rounded-2xl border-x border-b md:border border-line bg-card shadow-lg shadow-blue-100/80" id="screen-home">

    <div class="flex flex-col shrink-0 border-b border-line">
      <div class="flex items-center justify-between bg-gradient-to-r from-blue-600 to-sky-500 px-4 py-3 md:px-6 md:py-4 text-white">
        <div>
          <div class="text-lg md:text-xl font-semibold">Трекер привычек</div>
        </div>
        <div>
          <div class="text-sm md:text-base text-white/90 font-medium">Здравствуйте <b>{{user.name}}</b>!</div>
          <div class="text-sm md:text-base text-white/90 font-medium">
            Сегодня: {{ "now"|date('d ') }}{{ "now"|date('M')|trans }}
          </div>      
        </div>
      </div>

      <div class="flex px-4 py-2 md:p-5 items-center justify-between bg-card">
        <h2 class="text-lg md:text-xl font-semibold text-slate-800">Категории</h2>
        <a class="text-xs md:text-sm font-medium text-brand hover:underline bg-brand-soft px-3 py-1.5 rounded-lg transition-colors" href="{{ path('category_new') }}" onclick="show('category-form');return false;">
          + категория
        </a>
      </div>
    </div>

    <div class="p-4 md:p-6 flex-1 overflow-y-auto pb-6 md:pb-6">
      
      <div class="space-y-2 md:space-y-0 md:grid md:grid-cols-2 md:gap-4">
        {% if categories is not empty %}
            {% for category in categories %}                 
              <div class="flex items-center justify-between rounded-xl border border-line bg-page hover:shadow-sm transition-shadow min-h-[56px]">
                <a class="flex-1 px-3 py-3 hover:text-brand transition-colors text-lg md:text-xl font-bold text-slate-700 truncate" href="{{ path('category_view', {'id': category.id}) }}">
                  {{ category.name }}
                </a>
                <div class="flex items-center gap-3 text-xs md:text-sm pr-4 shrink-0">
                  <a class="text-muted hover:text-brand transition-colors py-1" href="{{ path('category_update', {'id': category.id}) }}">изм.</a>
                  <span class="text-line">|</span>
                  <a class="text-muted hover:text-bad transition-colors py-1" href="{{ path('category_delete', {'id': category.id}) }}" onclick="return confirm('Удалить категорию?');">удл.</a>
                </div>
              </div>
            {% endfor %}
        {% else %}
            <div class="md:col-span-2 rounded-xl border border-dashed border-line p-8 text-center text-xs md:text-sm text-muted">
                Категории на сегодня не созданы.
            </div>
        {% endif %}
      </div>

    </div>

    <nav class="shrink-0 bg-card border-t border-line p-4 shadow-[0_-4px_12px_rgba(0,0,0,0.05)] z-50 flex flex-wrap justify-around gap-2 text-xs font-semibold uppercase tracking-wider md:justify-start md:gap-x-6 md:font-medium md:text-sm">
      <a class="text-muted hover:text-brand transition-colors py-1 px-2" href="{{ path('activity_log_index') }}" onclick="show('journal');return false;">журнал</a>
      <a class="text-muted hover:text-brand transition-colors py-1 px-2" href="#" onclick="show('admin');return false;">админка</a>
      <a class="text-muted hover:text-bad transition-colors py-1 px-2" href="{{ path('app_logout') }}" onclick="show('login');return false;">выйти</a>
    </nav>

  </section>
{% endblock %}
