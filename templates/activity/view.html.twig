{% extends 'base.html.twig' %}

{% block body %}
<section class="w-[360px] overflow-hidden rounded-2xl border border-line bg-card shadow-lg shadow-blue-100/80" id="screen-activity">
    <div class="border-b border-line px-4 py-3">
        <a class="text-sm text-brand" href="{{ path('category_view', {'id': category.id}) }}" onclick="show('category');return false;">← {{category.name}}</a>
        <h2 class="text-xl font-semibold">{{activity.name}}</h2>
        <p class="text-xs text-muted">ед.: км · шаг: 1 · цель/день: 5</p>
    </div>
    
    <div class="p-4">
        <form id="activity-form" action="{{ path('record_new', {'id': activity.id}) }}" method="POST" class="rounded-2xl border border-line bg-page p-4">
            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="mb-1 block text-xs text-muted">значение</label>
                    <input name="amount" placeholder="значение"  class="w-full rounded-xl border border-line bg-white px-3 py-2.5" type="number" step="any" value="" required>
                </div>
                <div>
                    <label class="mb-1 block text-xs text-muted">дата</label>
                    <input id="date-input" name="date" class="w-full rounded-xl border border-line bg-white px-3 py-2.5" type="date" value="{{ 'now'|date('Y-m-d') }}" required>
                </div>
            </div>
            <button type="submit" class="mt-3 min-h-11 w-full rounded-xl bg-brand font-medium text-white shadow-md shadow-brand/10 transition-colors hover:bg-brand-dark">
                записать
            </button>
        </form>

        <p class="mb-2 mt-4 text-xs font-medium uppercase tracking-wide text-muted">история</p>
        <div class="flex flex-wrap gap-1.5">
            <a class="rounded-full px-3 py-1.5 text-xs text-muted hover:bg-brand-soft" href="#">неделя</a>
            <a class="rounded-full bg-brand px-3 py-1.5 text-xs font-medium text-white" href="#">месяц</a>
            <a class="rounded-full px-3 py-1.5 text-xs text-muted hover:bg-brand-soft" href="#">полгода</a>
            <a class="rounded-full px-3 py-1.5 text-xs text-muted hover:bg-brand-soft" href="#">год</a>
            <a class="rounded-full px-3 py-1.5 text-xs text-muted hover:bg-brand-soft" href="#" onclick="show('custom-filter');return false;">свой</a>
        </div>
        
        <div class="mt-3 rounded-xl bg-brand-soft px-3 py-2 text-sm text-brand">Σ месяц = {{activitySum.sum}} {{ activity.unit == 1 ? 'раз' : (activity.unit == 2 ? 'км' : 'мин') }} · {{activityCount.count}} записей</div>

        {% if records is not empty %}
            <ul class="mt-3 divide-y divide-line overflow-hidden rounded-2xl border border-line bg-white">
            {% for record in records %}  
                <li class="flex justify-between px-3 py-2.5">
                    <span>{{ record.created_at|date('d M')|trans }} · <b>{{ record.amount }}</b> {{ activity.unit == 1 ? 'раз' : (activity.unit == 2 ? 'км' : 'мин') }}</span>
                    <span class="text-xs"><a class="text-bad" href="{{ path('record_delete', {'id': record.id}) }}" onclick="return confirm('Удалить запись?');">уд.</a></span>
                </li>
            {% endfor %}
            </ul>
          {% else %}
          <div class="md:col-span-2 rounded-xl border border-dashed border-line p-8 text-center text-xs md:text-sm text-muted">
              История записей пуста
          </div>
      {% endif %}

</section>

<script>
document.getElementById('activity-form').addEventListener('submit', function(e) {
    const dateInput = document.getElementById('date-input').value;
});
</script>
{% endblock %}

