{% extends 'base.html.twig' %}

{% block body %}
<section class="w-full max-w-md md:max-w-4xl mx-auto mt-0 md:mt-6 h-screen md:h-[90vh] flex flex-col overflow-hidden rounded-b-2xl md:rounded-2xl border-x border-b md:border border-line bg-card shadow-lg shadow-blue-100/80" id="screen-home">
    
    <div class="flex-shrink-0 border-b border-line px-4 py-3">
        <div class="mb-1">
            <a class="text-sm text-brand" href="{{ path('category_view', {'id': category.id}) }}" onclick="show('category');return false;">← {{category.name}}</a>
        </div>
        <div class="flex items-center justify-between gap-4">
            <h2 class="text-xl font-semibold text-slate-800 m-0">{{activity.name}}</h2>
            <div class="flex items-center gap-3 text-xs whitespace-nowrap">
                <a class="text-muted hover:text-brand transition-colors" href="{{ path('activity_update', {'id': activity.id}) }}">изм.</a>
                <span class="text-line">|</span>
                <a class="text-muted hover:text-danger transition-colors" href="{{ path('activity_delete', {'id': activity.id}) }}" onclick="return confirm('Удалить активность?');">удл.</a>
            </div>
        </div>
    </div>

    {{ include('_partials/_flash_messages.html.twig') }}
    
    <div class="flex-shrink-0 p-4 pb-0">
        <form id="activity-form" action="{{ path('record_new', {'id': activity.id}) }}" method="POST" class="rounded-2xl border border-line bg-page p-4">
            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="mb-1 block text-xs text-muted">значение</label>
                    {% include '_partials/_amount_input.html.twig' with {
                        'placeholder': 'значение',
                        'input_class': 'w-full rounded-xl border border-line bg-white px-3 py-2.5'
                    } %}
                </div>
                <div>
                    <label class="mb-1 block text-xs text-muted">дата</label>
                    <input id="date-input" name="date" class="w-full rounded-xl border border-line bg-white px-3 py-2.5" type="date" value="{{ 'yesterday'|date('Y-m-d') }}" required>
                </div>
            </div>
            <button type="submit" class="mt-3 min-h-11 w-full rounded-xl bg-brand font-medium text-white shadow-md shadow-brand/10 transition-colors hover:bg-brand-dark">
                записать
            </button>
        </form>

        <p class="mb-2 mt-4 text-xs font-medium uppercase tracking-wide text-muted">история</p>
        <div class="flex flex-wrap gap-1.5">
            <form action="{{ path('activity_view', {'id': activity.id}) }}" method="POST" class="flex-1">
                <input type="hidden" name="filter" value="today">
            
                <button type="submit" 
                        class="w-full rounded-full px-3 py-1.5 text-xs  
                            {{filter == 'today' 
                                ? 'font-medium bg-brand text-white' 
                                : 'text-muted hover:bg-brand-soft' }}">
                    сегодня
                </button>
            </form>
            <form action="{{ path('activity_view', {'id': activity.id}) }}" method="POST" class="flex-1">
                <input type="hidden" name="filter" value="yesterday">
            
                <button type="submit" 
                        class="w-full rounded-full px-3 py-1.5 text-xs  
                            {{filter == 'yesterday' 
                                ? 'font-medium bg-brand text-white' 
                                : 'text-muted hover:bg-brand-soft' }}">
                    вчера
                </button>
            </form>
            <form action="{{ path('activity_view', {'id': activity.id}) }}" method="POST" class="flex-1">
                <input type="hidden" name="filter" value="week">
            
                <button type="submit" 
                        class="w-full rounded-full px-3 py-1.5 text-xs  
                            {{filter == 'week' 
                                ? 'font-medium bg-brand text-white' 
                                : 'text-muted hover:bg-brand-soft' }}">
                    неделя
                </button>
            </form>
            <form action="{{ path('activity_view', {'id': activity.id}) }}" method="POST" class="flex-1">
                <input type="hidden" name="filter" value="month">
            
                <button type="submit" 
                        class="w-full rounded-full px-3 py-1.5 text-xs  
                            {{filter == 'month' 
                                ? 'font-medium bg-brand text-white' 
                                : 'text-muted hover:bg-brand-soft' }}">
                    с 1-го
                </button>
            </form>
            <form action="{{ path('activity_view', {'id': activity.id}) }}" method="POST" class="flex-1">
                <input type="hidden" name="filter" value="all-time">
            
                <button type="submit" 
                        class="w-full rounded-full px-3 py-1.5 text-xs  
                            {{filter == 'all-time' 
                                ? 'font-medium bg-brbgand text-white' 
                                : 'text-muted hover:-brand-soft' }}">
                    за всё время
                </button>
            </form>
            <a class="rounded-full px-3 py-1.5 text-xs text-muted hover:bg-brand-soft text-center flex-1" href="#" onclick="show('custom-filter');return false;">свой</a>
        </div>

    {# <div class="grid grid-cols-3 gap-1.5 w-full">
        {% set buttons = [
            {'value': 'today', 'label': 'сегодня'},
            {'value': 'yesterday', 'label': 'вчера'},
            {'value': 'week', 'label': 'неделя'},
            {'value': 'month', 'label': 'с 1-го'},
            {'value': 'all-time', 'label': 'за всё время'}
        ] %}

        {% for btn in buttons %}
            <form action="{{ path('activity_view', {'id': activity.id}) }}" method="POST" class="w-full">
                <input type="hidden" name="filter" value="{{ btn.value }}">
            
                <button type="submit" 
                        class="w-full rounded-full px-2 py-1.5 text-xs text-center transition-colors
                            {{ filter == btn.value 
                                ? 'font-medium bg-brand text-white' 
                                : 'text-muted hover:bg-brand-soft bg-gray-50' }}">
                    {{ btn.label }}
                </button>
            </form>
        {% endfor %}

        <a href="#" 
        onclick="show('custom-filter');return false;"
        class="w-full rounded-full px-2 py-1.5 text-xs text-muted hover:bg-brand-soft bg-gray-50 text-center flex items-center justify-center transition-colors">
            свой
        </a>
    </div> #}
        
        <div class="mt-3 rounded-xl bg-brand-soft px-3 py-2 text-sm text-brand">Σ = {{activitySum.sum + 0}} {{ activity.unit == 1 ? 'раз' : (activity.unit == 2 ? 'км' : (activity.unit == 3 ? 'мин' : 'стр')) }} · {{activityCount.count + 0}} записей</div>
    </div>

    <div class="flex-1 overflow-y-auto p-4 pt-3">
        {% if records is not empty %}
            <ul class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-white">
            {% for record in records %}  
                <li class="flex justify-between px-3 py-2.5 text-sm md:text-base text-slate-700">
                    <span>{{ record.created_at|date('d M H:i:s')|trans }} · <b>{{ record.amount + 0}}</b> {{ activity.unit == 1 ? 'раз' : (activity.unit == 2 ? 'км' : (activity.unit == 3 ? 'мин' : 'стр')) }}</span>
                    <span class="text-xs md:text-sm flex items-center"><a class="text-bad hover:underline" href="{{ path('record_delete', {'id': record.id}) }}" onclick="return confirm('Удалить запись?');">уд.</a></span>
                </li>
            {% endfor %}
            </ul>
        {% else %}
            <div class="rounded-xl border border-dashed border-line p-8 text-center text-xs md:text-sm text-muted">
                История записей пуста
            </div>
        {% endif %}
    </div>

</section>

<script>
    document.getElementById('activity-form').addEventListener('submit', function(e) {
        const dateInput = document.getElementById('date-input').value;
    });
</script>
{% endblock %}
