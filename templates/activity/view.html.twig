{% extends 'base.html.twig' %}

{% block body %}
<section class="w-[360px] overflow-hidden rounded-2xl border border-line bg-card shadow-lg shadow-blue-100/80" id="screen-activity">
    <div class="border-b border-line px-4 py-3">
    <a class="text-sm text-brand" href="{{ path('category_view', {'id': category.id}) }}" onclick="show('category');return false;">← {{category.name}}</a>
    <h2 class="text-xl font-semibold">{{activity.name}}</h2>
    <p class="text-xs text-muted">ед.: км · шаг: 1 · цель/день: 5</p>
    </div>
    <div class="p-4">
    <div class="rounded-2xl border border-line bg-page p-4">
        <div class="grid grid-cols-2 gap-2">
        <div>
            <label class="mb-1 block text-xs text-muted">значение</label>
            <input class="w-full rounded-xl border border-line bg-white px-3 py-2.5" type="number" value="2.5">
        </div>
        <div>
            <label class="mb-1 block text-xs text-muted">дата</label>
            <input class="w-full rounded-xl border border-line bg-white px-3 py-2.5" type="date" value="2026-07-30">
        </div>
        </div>
        <button class="mt-3 min-h-11 w-full rounded-xl bg-brand font-medium text-white">записать</button>
    </div>

    <p class="mb-2 mt-4 text-xs font-medium uppercase tracking-wide text-muted">история</p>
    <div class="flex flex-wrap gap-1.5">
        <a class="rounded-full px-3 py-1.5 text-xs text-muted hover:bg-brand-soft" href="#">неделя</a>
        <a class="rounded-full bg-brand px-3 py-1.5 text-xs font-medium text-white" href="#">месяц</a>
        <a class="rounded-full px-3 py-1.5 text-xs text-muted hover:bg-brand-soft" href="#">полгода</a>
        <a class="rounded-full px-3 py-1.5 text-xs text-muted hover:bg-brand-soft" href="#">год</a>
        <a class="rounded-full px-3 py-1.5 text-xs text-muted hover:bg-brand-soft" href="#" onclick="show('custom-filter');return false;">свой</a>
    </div>
    <div class="mt-3 rounded-xl bg-brand-soft px-3 py-2 text-sm text-brand">Σ месяц = 42.5 км · 18 записей</div>
    <ul class="mt-3 divide-y divide-line overflow-hidden rounded-2xl border border-line bg-white">
        <li class="flex justify-between px-3 py-2.5"><span>30 июл · <b>+5</b> км</span><span class="text-xs"><a class="text-brand" href="#">изм.</a> · <a class="text-bad" href="#">уд.</a></span></li>
        <li class="flex justify-between px-3 py-2.5"><span>29 июл · <b>+3</b> км</span><span class="text-xs"><a class="text-brand" href="#">изм.</a> · <a class="text-bad" href="#">уд.</a></span></li>
        <li class="flex justify-between px-3 py-2.5"><span>28 июл · <b>+2.5</b> км</span><span class="text-xs"><a class="text-brand" href="#">изм.</a> · <a class="text-bad" href="#">уд.</a></span></li>
    </ul>
    </div>
</section>
{% endblock %}