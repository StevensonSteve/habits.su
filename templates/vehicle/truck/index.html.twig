{% extends 'base.html.twig' %}

{% block title %}Truck index{% endblock %}

{% block body %}
    <h1>Truck index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>CreatedAt</th>
                <th>UpdatedAt</th>
                <th>Id</th>
                <th>Vin</th>
                <th>Brand</th>
                <th>Model</th>
                <th>ManufactureDate</th>
                <th>MileageInitial</th>
                <th>EngineType</th>
                <th>EngineCapacity</th>
                <th>EngineVolume</th>
                <th>PurchaseDate</th>
                <th>Color</th>
                <th>LicensePlate</th>
                <th>MaxWeight</th>
                <th>EmptyWeight</th>
                <th>Description</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for truck in trucks %}
            <tr>
                <td>{{ truck.createdAt ? truck.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ truck.updatedAt ? truck.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ truck.id }}</td>
                <td>{{ truck.vin }}</td>
                <td>{{ truck.brand }}</td>
                <td>{{ truck.model }}</td>
                <td>{{ truck.manufactureDate ? truck.manufactureDate|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ truck.mileageInitial }}</td>
                <td>{{ truck.engineType.value }}</td>
                <td>{{ truck.engineCapacity }}</td>
                <td>{{ truck.engineVolume }}</td>
                <td>{{ truck.purchaseDate ? truck.purchaseDate|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ truck.color }}</td>
                <td>{{ truck.licensePlate }}</td>
                <td>{{ truck.maxWeight }}</td>
                <td>{{ truck.emptyWeight }}</td>
                <td>{{ truck.description }}</td>
                <td>
                    <a href="{{ path('app_vehicle_truck_show', {'id': truck.id}) }}">show</a>
                    <a href="{{ path('app_vehicle_truck_edit', {'id': truck.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="18">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_vehicle_truck_new') }}">Create new</a>
{% endblock %}
