{% extends 'base.html.twig' %}

{% block title %}Todo{% endblock %}

{% block body %}
<div class="mx-auto mt-8 max-w-5xl overflow-hidden rounded-2xl border border-line bg-card shadow-xl shadow-blue-100">
    <div class="border-b border-line bg-brand-soft px-4 py-2 text-xs font-medium text-brand">
        Пользователь: {{ user ? user.name : 'Гость' }}
    </div>
    
    <div class="grid md:grid-cols-12">
      <aside class="border-r border-line p-4 md:col-span-4">
        <div class="mb-2 text-xs uppercase tracking-wide text-muted">категории</div>
        <a class="mb-1 block rounded-xl bg-brand px-3 py-2.5 text-white" href="#">Все задачи · {{ user ? user.tasks|length : 0 }}</a>
      </aside>
      
      <main class="p-4 md:col-span-8">
        <div class="mb-3 flex justify-between">
          <h2 class="text-xl font-semibold">Список задач</h2>
          <a class="text-brand" href="#" onclick="show('activity-form');return false;">+ задача</a>
        </div>

        <div class="flex flex-col gap-3">
          {% if user and user.tasks is not empty %}
              {% for task in user.tasks %}
                <div class="rounded-2xl border border-line bg-page p-4 {% if task.isCompleted %}opacity-60 bg-gray-50{% endif %}">
                  <div class="flex items-center justify-between">
                    <strong class="{% if task.isCompleted %}line-through text-muted{% endif %}">
                        {{ task.title }}
                    </strong>
                    <span class="text-xs px-2 py-0.5 rounded-full {% if task.isCompleted %}bg-green-100 text-green-700{% else %}bg-amber-100 text-amber-700{% endif %}">
                        {% if task.isCompleted %}Выполнено{% else %}В процессе{% endif %}
                    </span>
                  </div>
                  
                  {% if task.description %}
                    <p class="text-xs text-muted mt-1">{{ task.description }}</p>
                  {% endif %}
                  
                  <p class="text-[10px] text-muted mt-2">Создано: {{ task.createdAt|date('d.m.Y H:i') }}</p>
                </div>
              {% endfor %}
          {% else %}
              <div class="rounded-2xl border border-dashed border-line p-8 text-center text-muted">
                  Задачи не найдены или пользователь не существует.
              </div>
          {% endif %}
        </div>
      </main>
    </div>
</div>
{% endblock %}
