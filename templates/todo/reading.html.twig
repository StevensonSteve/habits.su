{% extends 'base.html.twig' %}

{% block title %}Todo{% endblock %}

{% block body %}

<div class="mx-auto mt-8 max-w-5xl overflow-hidden rounded-2xl border border-line bg-card shadow-xl shadow-blue-100">
    <div class="border-b border-line bg-brand-soft px-4 py-2 text-xs font-medium text-brand">Десктоп · Tailwind</div>
    <div class="grid md:grid-cols-12">
      <aside class="border-r border-line p-4 md:col-span-4">
        <div class="mb-2 text-xs uppercase tracking-wide text-muted">STEVEN HELLO THIS IS READING PAGE</div>
        <a class="mb-1 block rounded-xl bg-brand px-3 py-2.5 text-white" href="#">Спорт · 2/3</a>
        <div class="mb-1 rounded-xl border border-line px-3 py-2.5">Здоровье · 1/2</div>
        <div class="mb-1 rounded-xl border border-line px-3 py-2.5"><a href="{{ path('todo_reading') }}">Чтение · 0/1</a></div>
      </aside>
      <main class="p-4 md:col-span-8">
        <div class="mb-3 flex justify-between">
          <h2 class="text-xl font-semibold">Спорт</h2>
          <a class="text-brand" href="#" onclick="show('activity-form');return false;">+ занятие</a>
        </div>
        <div class="rounded-2xl border border-line bg-page p-4">
          <strong>Подтягивания</strong>
          <p class="text-xs text-muted">сегодня 12 раз · цель 20</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <button class="min-h-11 rounded-xl bg-brand px-4 text-white">+1</button>
            <button class="min-h-11 rounded-xl bg-brand px-4 text-white">+5</button>
            <button class="min-h-11 rounded-xl bg-brand px-4 text-white">+10</button>
            <button class="min-h-11 rounded-xl border border-line bg-white px-4 text-muted">своя</button>
          </div>
        </div>
      </main>
    </div>
  </div>
{% endblock %}


