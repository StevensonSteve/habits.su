<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <link rel="icon" type="image/png" href="{{ asset('pen.png') }}">

  <title>
    {% block title %}{% endblock %}
  </title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <style type="text/tailwindcss">
    @theme {
      --font-sans: "Segoe UI", ui-sans-serif, system-ui, sans-serif;
      --color-ink: #0f172a;
      --color-muted: #64748b;
      --color-page: #eff6ff;
      --color-card: #ffffff;
      --color-line: #bfdbfe;
      --color-brand: #2563eb;
      --color-brand-dark: #1d4ed8;
      --color-brand-soft: #dbeafe;
      --color-ok: #059669;
      --color-warn: #d97706;
      --color-bad: #dc2626;
      --color-flash: #059669;
      --color-flash-soft: #d1fae5;
      --color-flash-bad: #dc2626;
      --color-flash-bad-soft: #fee2e2;
    }
  </style>
</head>
<body>
  <section class="w-full max-w-md md:max-w-4xl mx-auto mt-0 md:mt-6 h-screen md:h-[90vh] flex flex-col overflow-hidden rounded-b-2xl md:rounded-2xl border-x border-b md:border border-line bg-card shadow-lg shadow-blue-100/80" id="screen-home">
    {{ include('_partials/header.html.twig') }}
    {% block body %}{% endblock %}
  </section>
</body>
</html>
